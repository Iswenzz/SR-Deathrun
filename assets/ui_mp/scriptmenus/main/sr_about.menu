// About pages: a striped contents list down the left with every chapter one click away, the page beside it.
#include "ui/components/base.inc"

#define ABOUT_TEXT_COLOR	0.85 0.85 0.85 1
#define ABOUT_HOVER(pid)	(localVarInt(ui_about_hover) == pid)
#define ABOUT_ROW_Y(pk)		(84 + ((pk) - 1) * 34)

#define ABOUT_TITLE_1		"Welcome"
#define ABOUT_TITLE_2		"Commands"
#define ABOUT_TITLE_3		"Leaderboard"
#define ABOUT_TITLE_4		"How to play"
#define ABOUT_TITLE_5		"IW3SR"
#define ABOUT_TITLE_6		"Open Source"
#define ABOUT_TITLE_7		"Community"

#define ABOUT_FILL(px, py, pw, ph, pcolor) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		style			WINDOW_STYLE_FILLED \
		backcolor		pcolor \
		visible			1 \
		decoration \
	}

#define ABOUT_FILL_IF(px, py, pw, ph, pcolor, pcond) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		style			WINDOW_STYLE_FILLED \
		backcolor		pcolor \
		visible			when(pcond) \
		decoration \
	}

#define ABOUT_LABEL(px, py, pw, ph, ptext, pscale, palign, pcolor) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		type			ITEM_TYPE_TEXT \
		text			ptext \
		textfont		UI_FONT_NORMAL \
		textscale		pscale \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		palign \
		forecolor		pcolor \
		visible			1 \
		decoration \
	}

// The page text keeps its own line breaks, so it is not wrapped: py is the first line's baseline and
// lines are 14.4 apart. The longest lines need about 380 of width at this scale.
#define ABOUT_BODY(px, py, pbody) \
	itemDef \
	{ \
		rect			px py 384 230 SR_ALIGN_TOP_SUBLEFT \
		type			ITEM_TYPE_TEXT \
		text			pbody \
		textfont		UI_FONT_NORMAL \
		textscale		0.3 \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		ITEM_ALIGN_LEFT \
		forecolor		ABOUT_TEXT_COLOR \
		visible			1 \
		decoration \
	}

// Clickable part of a page link. pid lights the ABOUT_HOVER items drawn under it, unique in the page.
#define ABOUT_HIT(pid, px, py, pw, ph, plabel, palign, palignx, ptarget, pcond) \
	itemDef \
	{ \
		type			ITEM_TYPE_BUTTON \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		text			plabel \
		textfont		UI_FONT_NORMAL \
		textscale		0.26 \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		palign \
		textalignx		palignx \
		forecolor		1 1 1 1 \
		visible			when(pcond) \
		onFocus \
		{ \
			play "mouse_over"; \
			setLocalVarInt ui_about_hover pid; \
		} \
		leaveFocus \
		{ \
			setLocalVarInt ui_about_hover 0; \
		} \
		action \
		{ \
			play "mouse_click"; \
			close self; \
			open ptarget; \
		} \
	}

// pk is the chapter listed, ppage the page drawing the list; both are plain numbers.
#define ABOUT_CHAPTER(pk, ptitle, ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 154, 34, 0.5 0.1 1 0.55, pk == ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 3, 34, 0 1 1 1, pk == ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 154, 34, 0 1 1 0.14, ABOUT_HOVER(pk)) \
	ABOUT_LABEL(44, ABOUT_ROW_Y(pk), 20, 34, #pk, 0.26, ITEM_ALIGN_MIDDLE_RIGHT, ABOUT_TEXT_COLOR) \
	ABOUT_HIT(pk, 38, ABOUT_ROW_Y(pk), 154, 34, ptitle, ITEM_ALIGN_MIDDLE_LEFT, 34, about_page_##pk, 1)

// Previous or next. Like the original, the first page's previous and the last page's next reopen it.
#define ABOUT_STEP(pid, px, plabel, ptarget) \
	ABOUT_FILL(px, 364, 100, 26, 0.5 0.1 1 0.45) \
	ABOUT_FILL_IF(px, 364, 100, 26, 0 1 1 0.2, ABOUT_HOVER(pid)) \
	ABOUT_HIT(pid, px, 364, 100, 26, plabel, ITEM_ALIGN_MIDDLE_CENTER, 0, ptarget, 1)

#define ABOUT_PAGE(ppage, pprev, pnext, ptitle, pbody) \
	menuDef \
	{ \
		name			"about_page_" ## #ppage \
		rect			0 0 640 480 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
		focusColor		0 1 1 1 \
		onOpen \
		{ \
			setLocalVarInt ui_about_hover 0; \
		} \
		onEsc \
		{ \
			close self; \
		} \
		itemDef \
		{ \
			name			"window" \
			rect			30 50 580 350 SR_ALIGN_TOP_SUBLEFT \
			style			WINDOW_STYLE_FILLED \
			backcolor		0 0 0 0.6 \
			border			WINDOW_BORDER_FULL \
			bordersize		1 \
			bordercolor		0.5 0.1 1 0.6 \
			visible			1 \
			decoration \
		} \
		ABOUT_FILL(31, 51, 168, 348, 0 0 0 0.35) \
		ABOUT_FILL(199, 51, 2, 348, 0.5 0.1 1 0.8) \
		ABOUT_LABEL(44, 52, 140, 30, "Contents", 0.24, ITEM_ALIGN_MIDDLE_LEFT, ABOUT_TEXT_COLOR) \
		ABOUT_FILL(38, 84, 154, 238, 0 0 0 0.3) \
		ABOUT_FILL(38, ABOUT_ROW_Y(2), 154, 34, 1 1 1 0.04) \
		ABOUT_FILL(38, ABOUT_ROW_Y(4), 154, 34, 1 1 1 0.04) \
		ABOUT_FILL(38, ABOUT_ROW_Y(6), 154, 34, 1 1 1 0.04) \
		ABOUT_CHAPTER(1, ABOUT_TITLE_1, ppage) \
		ABOUT_CHAPTER(2, ABOUT_TITLE_2, ppage) \
		ABOUT_CHAPTER(3, ABOUT_TITLE_3, ppage) \
		ABOUT_CHAPTER(4, ABOUT_TITLE_4, ppage) \
		ABOUT_CHAPTER(5, ABOUT_TITLE_5, ppage) \
		ABOUT_CHAPTER(6, ABOUT_TITLE_6, ppage) \
		ABOUT_CHAPTER(7, ABOUT_TITLE_7, ppage) \
		ABOUT_LABEL(216, 52, 380, 36, ptitle, 0.42, ITEM_ALIGN_MIDDLE_LEFT, 1 1 1 1) \
		ABOUT_FILL(216, 90, 380, 2, 0.5 0.1 1 1) \
		ABOUT_BODY(216, 116, pbody) \
		ABOUT_STEP(11, 216, "< Previous", about_page_##pprev) \
		ABOUT_LABEL(316, 364, 180, 26, #ppage ## " / 7", 0.26, ITEM_ALIGN_MIDDLE_CENTER, ABOUT_TEXT_COLOR) \
		ABOUT_STEP(12, 496, "Next >", about_page_##pnext) \
		execKeyInt 13 \
		{ \
			scriptmenuresponse "enter"; \
		} \
		execKeyInt 32 \
		{ \
			scriptmenuresponse "space"; \
		} \
	}

{
	ABOUT_PAGE(1, 1, 2, ABOUT_TITLE_1, "^7Welcome to ^5SR Deathrun^7, a competitive ^5Call of Duty 4^7 deathrun mod\nbringing a full competitive and social experience\nto the classic deathrun format.\n\n^7One player takes the role of the ^5activator^7, armed with nothing but a series\nof deadly traps. The opposing team must navigate the course and reach\nthe end alive, then finish off the activator to win the round.\n\n^7Not every round plays the same. At random, a round may launch in an\nalternate movement mode such as ^5190, CS, Q3, Q3CPM, Q3CPMW^7 or ^5Portal^7,\nkeeping every game unpredictable and forcing players to adapt on the fly.\n\n^7Roll the ^5dice^7 once per round for a random outcome, spend ^5points^7 in the\nshop on lives, weapons, and health, or spawn as a ^5ghost^7 after dying to\nkeep practising the course without affecting the live round.")
	ABOUT_PAGE(2, 1, 3, ABOUT_TITLE_2, "^7A large set of commands is available to all players at any time.\nType ^2!help^7 in chat to browse the full list. Here are the most useful ones:\n\n^2!pm ^7Send a private message directly to another player on the server.\n^2!graphics ^7Re-enable common graphics settings if they were disabled.\n^2!fps ^7Toggle fullbright mode for improved frame rate.\n^2!fov ^7Adjust your field of view to your preference.\n^2!video ^7Request a video to be played on the in-game screen.")
	ABOUT_PAGE(3, 2, 4, ABOUT_TITLE_3, "^7Every completed run is tracked across all maps and movement modes,\nbrowsable directly from the main menu at any time.\n\n^7Each map supports ^5multiple routes^7, each with its own independent\nleaderboard so that times are always compared fairly within the same path.\n\n^7Use the filters to sort by movement mode, map, or route to find exactly\nthe records you are looking for, whether checking your own rank or scouting\nthe competition.\n\n^7Hit the ^5demo^7 button on any leaderboard to watch a full in-game\nplayback of the WR. This is the best way to study exactly how a record\nwas achieved, what routes were taken, and what techniques were used.")
	ABOUT_PAGE(4, 3, 5, ABOUT_TITLE_4, "^5Strafing ^7is the foundation of all movement modes. While airborne, hold\na strafe key and move your mouse in the same direction simultaneously.\nDone correctly, each jump builds speed beyond the normal movement cap.\n\n^5FPS switching ^7exploits how the engine ties physics calculations to frame\nrate. Different fps values change jump height, distance, and acceleration.\nBind fps values in console: ^2/bind KEY com_maxfps 125^7. Switching at the\nright moment before or during a jump opens up routes otherwise impossible.\n\n^5Bounces ^7are physics exploits triggered by colliding with geometry at very\nspecific angles and speeds, launching you across the map in an instant.\nThey are frame-precise and require consistent setup to execute reliably.\n\n^7Each mode has its own advanced techniques. Search the mode name alongside\n^2CoD4 speedrun^7 on YouTube to find tutorials and record breakdowns.")
	ABOUT_PAGE(5, 4, 6, ABOUT_TITLE_5, "^5IW3SR^7 is a custom CoD4 client.\nStrongly recommended for all players and essential for the smoothest\nexperience on custom movement modes like Q3, Q3CPM, CS, and Portal.\n\n^5Velocity meter: ^7Real-time velocity display showing your exact speed at\n^7all times, essential for learning and optimizing movement.\n^5CGAZ: ^7Visualizes strafe zones on screen, showing the optimal angle\n^7window to maximize acceleration during every airborne moment.\n^5Bhop script: ^7Optimized bunny hop input handling built directly into\n^7the client for consistent jumps without timing variance.\n^5KMOV: ^7Fully customizable dynamic HUD displays for movement data.\n^5Built-in browser: ^7Watch videos in-game without alt-tabbing.\n\n^7Download and source available at ^2github.com/Iswenzz/IW3SR")
	ABOUT_PAGE(6, 5, 7, ABOUT_TITLE_6, "^7The entire SR project is open source and community maintained.\nEvery part of the server, client, and tooling is publicly available\nfor anyone to explore, learn from, or contribute to.\n\n^7The full codebase is hosted on GitHub. You can browse the source,\nopen issues, suggest features, or submit pull requests directly at\n^2github.com/Iswenzz\n\n^7Contributions of all kinds are welcome and appreciated.\n^7The project grows because of the community. If you have skills\nand want to contribute, the door is open.")
	ABOUT_PAGE(7, 6, 7, ABOUT_TITLE_7, "^7An active community of players, speedrunners, and mappers is\nalways online. Whether you are looking for help, want to share a run,\nor just want to follow the latest updates, come join us.\n\nThe ^5Discord^7 is the heart of the community. It is the best place\nto ask questions, get feedbacks, report bugs, and stay up to date with every\nnew map release, mode update, and server announcement.\n\n^5Website: ^2sr-speedrun.com\n^5Discord: ^2discord.gg/76aHfGF\n^5GitHub: ^2github.com/Iswenzz")
}
